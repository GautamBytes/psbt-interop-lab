{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/dist",
      "!!.vercel",
      "!!artifacts",
      "!!adapters/rust-bitcoin/target",
      "!!adapters/bdk-wallet-current/target",
      "!!adapters/rust-psbt-v2/target",
      "!!src/generated/validators.ts",
      "!!website/src/generated/conformance-rules.ts",
      "!!website/*.tsbuildinfo",
      "!!website/vite.config.js",
      "!!website/vite.config.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}
