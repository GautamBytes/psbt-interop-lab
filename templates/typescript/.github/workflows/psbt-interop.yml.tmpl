name: PSBT interoperability

on:
  push:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  psbt-interop:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@df4cb1c969e1874edd31b4311f1884172cec0e10 # v6
        with:
          persist-credentials: false
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38 # v6
        with:
          node-version: 24
          cache: npm
          package-manager-cache: false
      - run: npm ci
      - run: npm test
      - name: Run PSBT interoperability matrix
        uses: GautamBytes/psbt-interop-lab@v{{LAB_VERSION}}
        with:
          adapter-manifest: adapter-manifest.json
          package-spec: psbt-interop-lab@{{LAB_VERSION}}
