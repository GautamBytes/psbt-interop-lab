{
  "name": "psbt-interop-lab",
  "version": "0.9.0",
  "description": "Deterministic PSBT interoperability testing for Bitcoin software",
  "keywords": [
    "bitcoin",
    "psbt",
    "interoperability",
    "regtest",
    "testing"
  ],
  "homepage": "https://github.com/GautamBytes/psbt-interop-lab#readme",
  "bugs": {
    "url": "https://github.com/GautamBytes/psbt-interop-lab/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GautamBytes/psbt-interop-lab.git"
  },
  "type": "module",
  "private": false,
  "bin": {
    "psbt-lab": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "src/conformance/adapter-manifest.schema.json",
    "src/custom/suite-manifest.schema.json",
    "scripts",
    "templates",
    "compose.yaml",
    "docker",
    "adapters/bdkpython-2.3.1/Dockerfile",
    "adapters/bdkpython-2.3.1/*.py",
    "adapters/bdkpython-2.3.1/requirements.txt",
    "adapters/bitcoinjs-lib/Dockerfile",
    "adapters/bitcoinjs-lib/*.mjs",
    "adapters/bitcoinjs-lib/*.json",
    "adapters/bitcoinjs-lib/test",
    "adapters/btcsuite-go/Dockerfile",
    "adapters/btcsuite-go/*.go",
    "adapters/btcsuite-go/go.mod",
    "adapters/btcsuite-go/go.sum",
    "adapters/btcsuite-go/cmd",
    "adapters/rust-bitcoin/Cargo.lock",
    "adapters/rust-bitcoin/Cargo.toml",
    "adapters/rust-bitcoin/Dockerfile",
    "adapters/rust-bitcoin/src",
    "adapters/rust-bitcoin/tests",
    "adapters/bdk-wallet-current/Cargo.lock",
    "adapters/bdk-wallet-current/Cargo.toml",
    "adapters/bdk-wallet-current/.dockerignore",
    "adapters/bdk-wallet-current/Dockerfile",
    "adapters/bdk-wallet-current/README.md",
    "adapters/bdk-wallet-current/src",
    "adapters/bdk-wallet-current/tests",
    "adapters/rust-psbt-v2/Cargo.lock",
    "adapters/rust-psbt-v2/Cargo.toml",
    "adapters/rust-psbt-v2/.dockerignore",
    "adapters/rust-psbt-v2/Dockerfile",
    "adapters/rust-psbt-v2/README.md",
    "adapters/rust-psbt-v2/src/lib.rs",
    "adapters/rust-psbt-v2/src/main.rs",
    "adapters/rust-psbt-v2/tests/bip370_parse_invalid.rs",
    "adapters/rust-psbt-v2/tests/bip370_parse_valid.rs",
    "adapters/rust-psbt-v2/tests/process.rs",
    "adapters/rust-psbt-v2/tests/protocol.rs",
    "adapters/rust-psbt-v2/tests/util.rs",
    "adapters/rust-psbt-v2/tests/workflow.rs",
    "adapters/libwally-1.5.4/.dockerignore",
    "adapters/libwally-1.5.4/Dockerfile",
    "adapters/libwally-1.5.4/*.py",
    "adapters/libwally-1.5.4/build-requirements.txt",
    "adapters/musig2-rust/Cargo.lock",
    "adapters/musig2-rust/Cargo.toml",
    "adapters/musig2-rust/.dockerignore",
    "adapters/musig2-rust/Dockerfile",
    "adapters/musig2-rust/README.md",
    "adapters/musig2-rust/src",
    "adapters/musig2-rust/tests",
    "adapters/musig2-scure/.dockerignore",
    "adapters/musig2-scure/Dockerfile",
    "adapters/musig2-scure/README.md",
    "adapters/musig2-scure/adapter.mjs",
    "adapters/musig2-scure/package.json",
    "adapters/musig2-scure/package-lock.json",
    "adapters/musig2-scure/tsconfig.json",
    "adapters/musig2-scure/test",
    "adapters/hwi-simulator/.dockerignore",
    "adapters/hwi-simulator/Dockerfile",
    "adapters/hwi-simulator/README.md",
    "adapters/hwi-simulator/*.mjs",
    "adapters/hwi-simulator/package.json",
    "adapters/hwi-simulator/package-lock.json",
    "adapters/hwi-simulator/tsconfig.json",
    "adapters/hwi-simulator/test",
    "examples/custom-suite.json",
    "examples/parser-regression-suite.json",
    "docs/*.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md",
    "SECURITY.md",
    "psbt-interop-lab-threat-model.md",
    "LICENSE"
  ],
  "scripts": {
    "generate:conformance-data": "tsx scripts/generate-conformance-data.ts",
    "check:conformance-data": "tsx scripts/generate-conformance-data.ts --check",
    "generate:validators": "tsx scripts/generate-validators.ts",
    "check:validators": "tsx scripts/generate-validators.ts --check",
    "build": "pnpm generate:conformance-data && pnpm generate:validators && tsc -p tsconfig.build.json && tsx scripts/copy-static-assets.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "proof": "pnpm build && node scripts/proof.mjs",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "packageManager": "pnpm@10.30.2",
  "dependencies": {
    "@noble/curves": "2.3.0",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "license": "MIT"
}
