{
  "name": "@psbt-lab/cli",
  "version": "0.0.1",
  "description": "Deterministic PSBT workflow interoperability proof for Bitcoin software",
  "type": "module",
  "private": true,
  "bin": {
    "psbt-lab": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "proof": "pnpm build && node scripts/proof.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.2",
  "dependencies": {
    "ajv": "8.20.0",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "license": "MIT"
}
